// Core KPIs (table: gold_fact_sales)

Total Sales =
SUM ( gold_fact_sales[sales_amount] )

Total Cost =
SUM ( gold_fact_sales[cost_amount] )

Gross Profit =
[Total Sales] - [Total Cost]

Gross Margin % =
DIVIDE ( [Gross Profit], [Total Sales] )

Total Orders =
DISTINCTCOUNT ( gold_fact_sales[order_id] )

Units Sold =
SUM ( gold_fact_sales[quantity] )

Average Order Value =
DIVIDE ( [Total Sales], [Total Orders] )

Average Selling Price =
DIVIDE ( [Total Sales], [Units Sold] )

// Time intelligence
// Requires gold_dim_date marked as the date table and related to gold_fact_sales[order_date]

Sales YTD =
TOTALYTD ( [Total Sales], gold_dim_date[date] )

Gross Profit YTD =
TOTALYTD ( [Gross Profit], gold_dim_date[date] )

Sales PY =
CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( gold_dim_date[date] ) )

Sales YoY % =
DIVIDE ( [Total Sales] - [Sales PY], [Sales PY] )
